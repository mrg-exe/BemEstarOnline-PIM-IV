<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BemEstarOnline.Mobile.ViewModels"
             xmlns:c="clr-namespace:BemEstarOnline.Mobile.Views.Componentes"
             x:Class="BemEstarOnline.Mobile.Views.CriarContaPage"
             x:DataType="vm:CriarContaViewModel"
             Title="Criar conta">
    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="12" MaximumWidthRequest="520">
            <c:BotaoVoltar />
            <Label Text="Crie sua conta para comprar, acompanhar a entrega e assinar seus remédios de uso contínuo."
                   Style="{StaticResource TextoSuave}" />

            <Border Style="{StaticResource Cartao}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Nome completo" FontAttributes="Bold" />
                    <Entry Text="{Binding Nome}" Placeholder="Nome e sobrenome" MaxLength="120"
                           SemanticProperties.Description="Nome completo" />

                    <Label Text="Nome social (opcional)" FontAttributes="Bold" />
                    <Entry Text="{Binding NomeSocial}" MaxLength="120" SemanticProperties.Description="Nome social, opcional" />
                    <Label Style="{StaticResource TextoSuave}" FontSize="14"
                           Text="Se preencher, é assim que vamos te chamar no site, no app e na entrega." />

                    <Label Text="Data de nascimento (opcional)" FontAttributes="Bold" />
                    <Entry Text="{Binding Nascimento}" Placeholder="dia/mês/ano, ex.: 20/05/1998" Keyboard="Numeric" MaxLength="10"
                           SemanticProperties.Description="Data de nascimento, dia, mês e ano" />

                    <Label Text="CPF" FontAttributes="Bold" />
                    <Entry Text="{Binding Cpf}" Placeholder="000.000.000-00" Keyboard="Numeric" MaxLength="14"
                           SemanticProperties.Description="CPF" />

                    <Label Text="Celular (opcional)" FontAttributes="Bold" />
                    <Entry Text="{Binding Telefone}" Placeholder="(11) 90000-0000" Keyboard="Telephone" MaxLength="15"
                           SemanticProperties.Description="Celular, opcional" />

                    <Label Text="E-mail" FontAttributes="Bold" />
                    <Entry Text="{Binding Email}" Placeholder="seu@email.com" Keyboard="Email" SemanticProperties.Description="E-mail" />

                    <Label Text="Senha" FontAttributes="Bold" />
                    <Entry Text="{Binding Senha}" IsPassword="True" Placeholder="Pelo menos 6 caracteres" SemanticProperties.Description="Senha" />
                    <Label Text="Repita a senha" FontAttributes="Bold" />
                    <Entry Text="{Binding RepetirSenha}" IsPassword="True" SemanticProperties.Description="Repita a senha" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Cartao}">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <CheckBox IsChecked="{Binding Concordo}" Color="{DynamicResource CorPrimaria}" VerticalOptions="Start"
                                  SemanticProperties.Description="Concordo que meus dados sejam usados só para atender meus pedidos, LGPD" />
                        <Label Grid.Column="1" VerticalOptions="Center"
                               Text="Concordo que meus dados sejam usados só para atender meus pedidos (LGPD).">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AlternarConcordoCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <HorizontalStackLayout Spacing="4">
                        <Button Text="Política de Privacidade" Style="{StaticResource BotaoContorno}" BorderWidth="0"
                                Command="{Binding VerPrivacidadeCommand}" SemanticProperties.Description="Ler a Política de Privacidade" />
                        <Button Text="Termos de Uso" Style="{StaticResource BotaoContorno}" BorderWidth="0"
                                Command="{Binding VerTermosCommand}" SemanticProperties.Description="Ler os Termos de Uso" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding Erro}" TextColor="{DynamicResource CorTarja}" FontAttributes="Bold"
                   IsVisible="{Binding TemErro}" />
            <Button Text="Criar conta" Command="{Binding CriarCommand}" IsEnabled="{Binding Livre}" />
            <ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
