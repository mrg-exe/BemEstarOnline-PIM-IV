<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BemEstarOnline.Mobile.ViewModels"
             x:Class="BemEstarOnline.Mobile.Views.TextoLegalPage"
             x:DataType="vm:TextoLegalViewModel"
             Title="{Binding Titulo}">
    <ScrollView>
        <!-- Os blocos de texto são montados no code-behind (títulos, parágrafos e itens com negrito/itálico). -->
        <VerticalStackLayout x:Name="Conteudo" Padding="20,16,20,32" Spacing="10" MaximumWidthRequest="680" />
    </ScrollView>
</ContentPage>
