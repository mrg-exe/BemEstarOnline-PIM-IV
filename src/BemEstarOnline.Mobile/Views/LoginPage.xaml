<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BemEstarOnline.Mobile.ViewModels"
             x:Class="BemEstarOnline.Mobile.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             Title="Entrar">
    <ScrollView>
        <VerticalStackLayout Padding="24,28,24,24" Spacing="14" MaximumWidthRequest="520">
            <!-- Logo dentro de um círculo branco -->
            <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 70"
                    WidthRequest="140" HeightRequest="140" HorizontalOptions="Center" Padding="6">
                <Image Source="logo_bem_estar.png" Aspect="AspectFit" SemanticProperties.Description="Logotipo da Bem Estar Online" />
            </Border>
            <Label Text="Sua farmácia no bolso: compre, acompanhe a entrega e receba seus remédios de uso contínuo."
                   Style="{StaticResource TextoSuave}" HorizontalTextAlignment="Center" />

            <Border Style="{StaticResource Cartao}" Padding="18">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Entrar" Style="{StaticResource Titulo}" SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="E-mail" FontAttributes="Bold" />
                    <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="seu@email.com"
                           SemanticProperties.Description="Campo de e-mail" />
                    <Label Text="Senha" FontAttributes="Bold" />
                    <Entry Text="{Binding Senha}" IsPassword="True" Placeholder="Sua senha"
                           SemanticProperties.Description="Campo de senha" ReturnCommand="{Binding EntrarCommand}" />
                    <Button Text="Entrar" Command="{Binding EntrarCommand}" IsEnabled="{Binding Livre}" Margin="0,6,0,0" />
                    <ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}" />
                    <Button Text="Esqueci minha senha" Style="{StaticResource BotaoLink}"
                            Command="{Binding EsqueciSenhaCommand}" IsEnabled="{Binding Livre}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Criar conta" Style="{StaticResource BotaoContorno}"
                    Command="{Binding CriarContaCommand}" IsEnabled="{Binding Livre}" />
            <Button Text="Ver produtos sem entrar" Style="{StaticResource BotaoLink}"
                    Command="{Binding ContinuarSemEntrarCommand}" />

            <!-- Contas de teste da apresentação: um toque preenche e entra -->
            <Border Style="{StaticResource Cartao}" BackgroundColor="{DynamicResource CorFundo}" StrokeDashArray="4,3">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Contas de teste" Style="{StaticResource TituloSecao}" />
                    <Label Style="{StaticResource TextoSuave}" FontSize="14"
                           Text="Para a apresentação: entre com um toque como cliente (compras) ou como entregador (entregas)." />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="🛒 Cliente" Style="{StaticResource BotaoContorno}"
                                Command="{Binding EntrarComoCommand}" CommandParameter="cliente" IsEnabled="{Binding Livre}"
                                SemanticProperties.Description="Entrar com a conta de teste de cliente" />
                        <Button Grid.Column="1" Text="🛵 Entregador" Style="{StaticResource BotaoContorno}"
                                Command="{Binding EntrarComoCommand}" CommandParameter="entregador" IsEnabled="{Binding Livre}"
                                SemanticProperties.Description="Entrar com a conta de teste de entregador" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Configurar endereço do servidor" Style="{StaticResource BotaoLink}"
                    Command="{Binding AlternarServidorCommand}" />
            <Border Style="{StaticResource Cartao}" IsVisible="{Binding MostrarServidor}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Endereço da API" FontAttributes="Bold" />
                    <Entry Text="{Binding UrlApi}" Keyboard="Url" SemanticProperties.Description="Endereço da API" />
                    <Label Style="{StaticResource TextoSuave}" FontSize="14"
                           Text="No Windows: http://localhost:5088/api/. No emulador Android: http://10.0.2.2:5088/api/. No celular de verdade: o IP do computador na mesma rede Wi-Fi, por exemplo http://192.168.18.7:5088/api/ (veja o guia)." />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
