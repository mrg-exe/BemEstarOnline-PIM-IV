<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BemEstarOnline.Mobile.ViewModels"
             x:Class="BemEstarOnline.Mobile.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             Title="Entrar">
    <ScrollView>
        <VerticalStackLayout Padding="24,48,24,24" Spacing="14" MaximumWidthRequest="520">
            <Label Text="Bem Estar Online" Style="{StaticResource Titulo}" FontSize="30"
                   TextColor="{DynamicResource CorPrimariaEscura}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Sua farmácia no bolso: compre, acompanhe a entrega e receba seus remédios de uso contínuo."
                   Style="{StaticResource TextoSuave}" />

            <Border Style="{StaticResource Cartao}" Margin="0,12,0,0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="E-mail" FontAttributes="Bold" />
                    <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="seu@email.com"
                           SemanticProperties.Description="Campo de e-mail" />
                    <Label Text="Senha" FontAttributes="Bold" />
                    <Entry Text="{Binding Senha}" IsPassword="True" Placeholder="Sua senha"
                           SemanticProperties.Description="Campo de senha" ReturnCommand="{Binding EntrarCommand}" />
                    <Button Text="Entrar" Command="{Binding EntrarCommand}" IsEnabled="{Binding Livre}" Margin="0,8,0,0" />
                    <Button Text="Esqueci minha senha" Style="{StaticResource BotaoContorno}" BorderWidth="0"
                            Command="{Binding EsqueciSenhaCommand}" IsEnabled="{Binding Livre}" />
                    <ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}" />
                    <Button Text="Criar conta" Style="{StaticResource BotaoContorno}"
                            Command="{Binding CriarContaCommand}" IsEnabled="{Binding Livre}" />
                    <Button Text="Ver produtos sem entrar" Style="{StaticResource BotaoContorno}"
                            Command="{Binding ContinuarSemEntrarCommand}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Usar conta de teste (cliente)" Style="{StaticResource BotaoContorno}"
                    Command="{Binding PreencherTesteCommand}" />
            <Button Text="Configurar endereço do servidor" Style="{StaticResource BotaoContorno}"
                    Command="{Binding AlternarServidorCommand}" />

            <Border Style="{StaticResource Cartao}" IsVisible="{Binding MostrarServidor}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Endereço da API" FontAttributes="Bold" />
                    <Entry Text="{Binding UrlApi}" Keyboard="Url" />
                    <Label Style="{StaticResource TextoSuave}"
                           Text="No Windows use http://localhost:5088/api/. No emulador Android use http://10.0.2.2:5088/api/. Em celular de verdade, use o IP do computador na mesma rede Wi-Fi." />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
