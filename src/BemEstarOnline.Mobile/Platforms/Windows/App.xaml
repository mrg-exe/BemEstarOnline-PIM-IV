<maui:MauiWinUIApplication
    x:Class="BemEstarOnline.Mobile.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maui="using:Microsoft.Maui">
    <maui:MauiWinUIApplication.Resources>
        <!-- Cor de destaque do Windows (linha do campo em uso, bolinha das opções) no verde da farmácia, em vez do roxo padrão. -->
        <Color x:Key="SystemAccentColor">#00807C</Color>
        <Color x:Key="SystemAccentColorLight1">#1A9490</Color>
        <Color x:Key="SystemAccentColorLight2">#4DADA9</Color>
        <Color x:Key="SystemAccentColorLight3">#80C6C3</Color>
        <Color x:Key="SystemAccentColorDark1">#00706C</Color>
        <Color x:Key="SystemAccentColorDark2">#00625F</Color>
        <Color x:Key="SystemAccentColorDark3">#004D4A</Color>
    </maui:MauiWinUIApplication.Resources>
</maui:MauiWinUIApplication>
