<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:BemEstarOnline.Mobile.Views"
       x:Class="BemEstarOnline.Mobile.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Title="Bem Estar Online">

    <!-- Tela de entrada (fora das abas) -->
    <ShellContent Route="login" ContentTemplate="{DataTemplate views:LoginPage}" />

    <!-- Abas do entregador -->
    <TabBar Route="entregador">
        <ShellContent Route="entregas" Title="Entregas" ContentTemplate="{DataTemplate views:EntregasPage}" />
        <ShellContent Route="perfilentregador" Title="Perfil" ContentTemplate="{DataTemplate views:PerfilPage}" />
    </TabBar>

    <!-- Abas principais (cliente) -->
    <TabBar Route="principal">
        <ShellContent Route="catalogo" Title="Produtos" ContentTemplate="{DataTemplate views:CatalogoPage}" />
        <ShellContent Route="carrinho" Title="Carrinho" ContentTemplate="{DataTemplate views:CarrinhoPage}" />
        <ShellContent Route="pedidos" Title="Pedidos" ContentTemplate="{DataTemplate views:PedidosPage}" />
        <ShellContent Route="perfil" Title="Perfil" ContentTemplate="{DataTemplate views:PerfilPage}" />
    </TabBar>
</Shell>
